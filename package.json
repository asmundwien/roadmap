{
  "name": "roadmap",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "A live, read-only visualization of wayfinder-organized projects on GitHub.",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "pnpm --parallel dev",
    "build": "pnpm build",
    "typecheck": "tsc -b --noEmit && pnpm --filter @roadmap/docs typecheck && node scripts/check-contract-types.mjs",
    "test": "pnpm -r test",
    "check": "biome check . && pnpm architecture",
    "knip": "knip",
    "architecture": "node scripts/check-architecture.mjs && node --test scripts/browser-architecture-plugin.test.mjs scripts/source-boundaries.test.mjs scripts/proof-options.test.mjs && node scripts/check-browser-build-fixtures.mjs",
    "test:client-owner-browser": "node scripts/client-owner-browser.mjs",
    "test:resource-results-browser": "node scripts/resource-results-browser.mjs",
    "test:workflows-browser": "node scripts/workflows-browser.mjs",
    "fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "dependency-cruiser": "^18.5.0",
    "knip": "^6.39.0",
    "playwright": "^1.58.0",
    "typescript": "~6.0.2"
  }
}
