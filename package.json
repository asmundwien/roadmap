{
  "name": "roadmap",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "A live, read-only visualization of wayfinder-organized projects on GitHub.",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @roadmap/web --filter @roadmap/server dev",
    "dev:web": "pnpm --filter @roadmap/web dev",
    "dev:server": "pnpm --filter @roadmap/server dev",
    "build": "pnpm --filter @roadmap/web build",
    "preview": "pnpm --filter @roadmap/web preview",
    "typecheck": "tsc -b --noEmit",
    "test": "pnpm -r test",
    "test:watch": "pnpm --filter @roadmap/web test:watch",
    "check": "biome check .",
    "fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "typescript": "~6.0.2"
  }
}
