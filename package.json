{
  "name": "roadmap",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "A local view of GitHub and Local wayfinder projects with configuration, authorization, host actions, and opt-in Automation.",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "pnpm --parallel dev",
    "build": "pnpm build",
    "typecheck": "tsc -b --noEmit && pnpm --filter @roadmap/github typecheck && pnpm --filter @roadmap/docs typecheck",
    "test": "pnpm -r test",
    "check": "biome check .",
    "knip": "knip",
    "fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "knip": "^6.39.0",
    "typescript": "~6.0.2"
  }
}
