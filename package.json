{
  "name": "roadmap",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "A live, read-only visualization of wayfinder-organized projects on GitHub.",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --parallel dev",
    "build": "pnpm build",
    "typecheck": "tsc -b --noEmit && pnpm --filter @roadmap/docs typecheck",
    "test": "pnpm -r test",
    "check": "biome check .",
    "knip": "knip",
    "fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "knip": "^6.39.0",
    "typescript": "~6.0.2"
  }
}
