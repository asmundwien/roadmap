# Copy to .env.local (gitignored) and fill in.
#
# Credentials remain server-only in macOS Keychain. These GitHub App identifiers are public:
# one identifies the OAuth device-flow client, the other builds installation-management links.

ROADMAP_GITHUB_APP_CLIENT_ID=
ROADMAP_GITHUB_APP_SLUG=

# Port for the local server. Defaults to 8790.
#ROADMAP_SERVER_PORT=8790

# Exact browser origin allowed to call HTTP operations and open the state socket.
# Defaults to the Vite development origin.
#ROADMAP_WEB_ORIGIN=http://localhost:5173

# The browser-visible server HTTP origin. The store derives HTTP endpoints and `/ws` from it.
#VITE_ROADMAP_SERVER_URL=http://localhost:8790
