# Copy to .env.local (gitignored) and fill in.
#
# Everything here is read by the local server only — no VITE_ prefix anywhere, so Vite never
# exposes a value to the browser. The SPA carries no credentials at all; it just subscribes to
# the server's WebSocket.

# A GitHub personal access token, used for all reads (discovery search + map GraphQL query).
# Prefer a FINE-GRAINED token with "Issues: read" on the wayfinder repos, plus an expiry —
# then a leak costs read access to a few repos' issues, not the account.
# A classic token needs the `repo` scope. See docs/research/github-api-primitives.md §4b.
ROADMAP_GITHUB_TOKEN=

# The GitHub account whose repos are searched for `wayfinder:map` issues.
ROADMAP_GITHUB_USER=asmundwien

# The smee.io channel the GitHub App's webhook delivers to (relayed to the local server).
ROADMAP_SMEE_URL=
# HMAC secret set on the App's webhook; verification is best-effort (smee re-serializes bodies).
# See docs/research/webhook-path.md.
ROADMAP_WEBHOOK_SECRET=
# Port for the local server (HTTP webhook receiver + WebSocket). Defaults to 8790.
#ROADMAP_SERVER_PORT=8790

# The one browser-visible knob: where the SPA finds the server's socket. Only needed if the
# port above moves — the default is ws://localhost:8790/ws.
#VITE_ROADMAP_SERVER_URL=ws://localhost:8790/ws
