{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "html": {
    "experimentalFullSupportEnabled": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": {
          "level": "warn",
          "options": {
            "allow": ["error", "warn", "info"]
          }
        }
      },
      "style": {
        "noNonNullAssertion": "error",
        "noDefaultExport": "error",
        "useConst": "error"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": "warn"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "apps/web/vite.config.ts",
        "apps/docs/astro.config.mjs",
        "apps/server/vitest.config.ts",
        "packages/ui/vitest.config.ts",
        "config/dependency-cruiser/contracts.mjs",
        "config/dependency-cruiser/docs.mjs",
        "config/dependency-cruiser/server.mjs",
        "config/dependency-cruiser/typescript-resolve.mjs",
        "config/dependency-cruiser/ui.mjs",
        "config/dependency-cruiser/web.mjs"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/docs/**/*.astro"],
      "html": {
        "formatter": { "enabled": true }
      },
      "linter": {
        "rules": {
          "correctness": { "useJsxKeyInIterable": "off" }
        }
      }
    }
  ]
}
